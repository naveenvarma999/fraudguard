[Unit]
Description=Export verified FraudGuard backup to private S3 storage
Wants=network-online.target
After=network-online.target docker.service

[Service]
Type=oneshot
User=root
WorkingDirectory=/home/ubuntu/fraudguard
EnvironmentFile=/home/ubuntu/fraudguard/.backup-env
ExecStart=/usr/bin/bash /home/ubuntu/fraudguard/scripts/Export-Backup-S3.sh
TimeoutStartSec=1800
